# CogStay Production & Local Environment Configuration Template

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production

# MongoDB Atlas Database Credentials
MONGODB_CONNECTION_STRING=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE_NAME=CogStayDb

# JWT Bearer Token Security (Must be at least 256-bit / 32 characters)
JWT_SIGNING_KEY=CogStaySuperSecretProductionSigningKeyMustBe32BytesOrLonger2026!
JWT_ISSUER=CogStayAPI
JWT_AUDIENCE=CogStayApp
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7

# Email Provider Configuration (SMTP)
EMAIL_PROVIDER_HOST=smtp.sendgrid.net
EMAIL_PROVIDER_PORT=587
EMAIL_PROVIDER_USERNAME=apikey
EMAIL_PROVIDER_PASSWORD=SG.your_sendgrid_api_key_here
EMAIL_FROM=no-reply@cogstay.com

# SMS Provider Configuration (Twilio / TeleSign)
SMS_PROVIDER_API_KEY=SK_your_twilio_or_telesign_key_here
SMS_FROM=+18005550199

# Environment-aware CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://cogstay-mvc.azurewebsites.net,https://cogstay-api.azurewebsites.net

# Idempotent System Administrator Initial Seeder Credentials
ADMIN_SEED_EMAIL=admin@gmail.com
ADMIN_SEED_PASSWORD=AdminSecurePass2026!
