@model IEnumerable<CogStayMVC.DTOs.ReservationResponseDTO>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Reservations Queue";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Admin" : roleParam;
    }
}

<div class="table-action-header">
    <div>
        <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Guest Bookings & Reservations</h1>
        <p style="color: var(--color-text-muted);">Monitor guest stays, confirm new bookings, and process cancellations.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-calendar-plus"></i> New Reservation</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="cogstay-card">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-list-check"></i> Reservation Bookings</h3>
        <span class="cogstay-badge success">@Model.Count() Bookings Registered</span>
    </div>
    <div class="cogstay-table-responsive">
        <table class="cogstay-table">
            <thead>
                <tr>
                    <th>Reservation ID</th>
                    <th>Guest Name</th>
                    <th>Allotted Room</th>
                    <th>Check-In</th>
                    <th>Check-Out</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align: center; color: var(--color-text-muted);">No reservations found. Create a reservation to get started.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        string badgeClass = item.ReservationStatus switch
                        {
                            CogStayMVC.Enums.ReservationStatus.Booked => "success",
                            CogStayMVC.Enums.ReservationStatus.Cancelled => "danger",
                            _ => "secondary"
                        };

                        <tr>
                            <td><strong>#RES-@item.ReservationId</strong></td>
                            <td>@item.GuestName</td>
                            <td>Room @item.RoomNumber (@item.RoomType)</td>
                            <td>@item.CheckInDate.ToString("MMM dd, yyyy")</td>
                            <td>@item.CheckOutDate.ToString("MMM dd, yyyy")</td>
                            <td><span class="cogstay-badge @badgeClass">@item.ReservationStatus</span></td>
                            <td style="text-align: right; display: flex; gap: 8px; justify-content: flex-end;">
                                <a asp-action="Details" asp-route-id="@item.ReservationId" class="btn btn-secondary btn-sm">Details</a>
                                @if (item.ReservationStatus == CogStayMVC.Enums.ReservationStatus.Booked)
                                {
                                    <form asp-action="Cancel" asp-route-id="@item.ReservationId" method="post" style="display:inline;" onsubmit="return confirm('Cancel reservation #RES-@item.ReservationId?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-secondary btn-sm" style="border-color: var(--color-warning); color: var(--color-warning);">Cancel</button>
                                    </form>
                                }
                                <form asp-action="Delete" asp-route-id="@item.ReservationId" method="post" style="display:inline;" onsubmit="return confirm('Delete reservation #RES-@item.ReservationId?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-secondary btn-sm" style="border-color: var(--color-danger); color: var(--color-danger);">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
