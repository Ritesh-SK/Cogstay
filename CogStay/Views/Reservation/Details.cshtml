@model CogStay.Application.DTOs.ReservationResponseDTO
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Reservation Details";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Admin" : roleParam;
    }
    string badgeClass = Model.ReservationStatus switch
    {
        CogStay.Domain.Enums.ReservationStatus.Confirmed => "success",
        CogStay.Domain.Enums.ReservationStatus.Cancelled => "danger",
        _ => "secondary"
    };
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Reservation Booking Sheet</h1>
    <p style="color: var(--color-text-muted);">Review dates, guest profile data, and allotment settings for this reservation.</p>
</div>

<div class="booking-checkout-container">
    <div class="cogstay-card">
        <div class="cogstay-card-header">
            <h3 class="cogstay-card-title"><i class="fa-solid fa-file-invoice"></i> Booking Reference #RES-@Model.ReservationId</h3>
            <span class="cogstay-badge @badgeClass">@Model.ReservationStatus</span>
        </div>
        <div class="cogstay-card-body">
            <div class="grid-container grid-cols-2" style="gap: 15px; margin-bottom: 25px;">
                <div>
                    <span style="font-size: 13px; color: var(--color-text-muted); text-transform: uppercase;">Guest Profile</span>
                    <p style="font-size: 16px; font-weight: 600; margin-top: 3px;">@Model.GuestName</p>
                </div>
                <div>
                    <span style="font-size: 13px; color: var(--color-text-muted); text-transform: uppercase;">Allotted Room Unit</span>
                    <p style="font-size: 16px; font-weight: 600; margin-top: 3px;">Room @Model.RoomNumber (@Model.RoomType)</p>
                </div>
                <div>
                    <span style="font-size: 13px; color: var(--color-text-muted); text-transform: uppercase;">Expected Check-In</span>
                    <p style="font-size: 16px; font-weight: 600; margin-top: 3px;">@Model.CheckInDate.ToString("MMM dd, yyyy")</p>
                </div>
                <div>
                    <span style="font-size: 13px; color: var(--color-text-muted); text-transform: uppercase;">Expected Check-Out</span>
                    <p style="font-size: 16px; font-weight: 600; margin-top: 3px;">@Model.CheckOutDate.ToString("MMM dd, yyyy")</p>
                </div>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; border-top: 1px solid var(--color-border); padding-top: 20px;">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                @if (Model.ReservationStatus == CogStay.Domain.Enums.ReservationStatus.Confirmed)
                {
                    <a asp-controller="CheckIn" asp-action="CheckIn" class="btn btn-primary"><i class="fa-solid fa-sign-in-alt"></i> Process Guest Check-In</a>
                }
            </div>
        </div>
    </div>
</div>
