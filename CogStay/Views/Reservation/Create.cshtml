@model CogStay.Application.DTOs.CreateReservationDTO
@using CogStay.Application.DTOs
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Reservation";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Admin" : roleParam;
    }
    var guests = ViewBag.Guests as IEnumerable<GuestResponseDTO> ?? Enumerable.Empty<GuestResponseDTO>();
    var rooms = ViewBag.Rooms as IEnumerable<RoomResponseDTO> ?? Enumerable.Empty<RoomResponseDTO>();
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Create New Guest Booking</h1>
    <p style="color: var(--color-text-muted);">Fill in guest details and select dates to reserve a room allotment.</p>
</div>

<div class="cogstay-card" style="max-width: 800px;">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-calendar-plus"></i> Booking Reservation Form</h3>
    </div>
    <div class="cogstay-card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="cogstay-form-group">
                <label class="cogstay-form-label" asp-for="GuestId">Guest Profile</label>
                <select asp-for="GuestId" class="cogstay-form-control" required>
                    <option value="">-- Select Guest --</option>
                    @foreach (var g in guests)
                    {
                        <option value="@g.GuestId">@g.FullName (@g.Email)</option>
                    }
                </select>
                <span asp-validation-for="GuestId" class="text-danger"></span>
            </div>

            <div class="cogstay-form-group">
                <label class="cogstay-form-label" asp-for="RoomId">Allot Room Number</label>
                <select asp-for="RoomId" class="cogstay-form-control" required>
                    <option value="">-- Select Room --</option>
                    @foreach (var r in rooms)
                    {
                        <option value="@r.RoomId">Room @r.RoomNumber (@r.RoomType - @r.PricePerNight.ToString("C")/night)</option>
                    }
                </select>
                <span asp-validation-for="RoomId" class="text-danger"></span>
            </div>

            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="CheckInDate">Check-In Date</label>
                    <input asp-for="CheckInDate" type="date" class="cogstay-form-control" required />
                    <span asp-validation-for="CheckInDate" class="text-danger"></span>
                </div>
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="CheckOutDate">Check-Out Date</label>
                    <input asp-for="CheckOutDate" type="date" class="cogstay-form-control" required />
                    <span asp-validation-for="CheckOutDate" class="text-danger"></span>
                </div>
            </div>

            <div style="display: flex; gap: 15px; justify-content: flex-end; margin-top: 20px;">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Create Reservation</button>
            </div>
        </form>
    </div>
</div>
