@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var role = ViewData["Role"]?.ToString() ?? "Admin";
    ViewData["Title"] = role + " Dashboard";

    var arrivalsList = ViewBag.ArrivalsList as IEnumerable<CogStay.Application.DTOs.ReservationResponseDTO> ?? Enumerable.Empty<CogStay.Application.DTOs.ReservationResponseDTO>();
    var housekeepingTasksList = ViewBag.HousekeepingTasksList as IEnumerable<CogStay.Application.DTOs.HousekeepingTaskResponseDTO> ?? Enumerable.Empty<CogStay.Application.DTOs.HousekeepingTaskResponseDTO>();
    
    int availableRoomsCount = ViewBag.AvailableRoomsCount ?? 0;
    int totalRoomsCount = ViewBag.TotalRoomsCount ?? 0;
    int reservationsCount = ViewBag.ReservationsCount ?? 0;
    int activeStaysCount = ViewBag.ActiveStaysCount ?? 0;
    int pendingTasksCount = ViewBag.PendingTasksCount ?? 0;
    int inProgressTasksCount = ViewBag.InProgressTasksCount ?? 0;
    int completedTasksCount = ViewBag.CompletedTasksCount ?? 0;
    decimal pendingPaymentAmount = ViewBag.PendingPaymentAmount ?? 0m;
    int pendingBillsCount = ViewBag.PendingBillsCount ?? 0;
    int totalStaffCount = ViewBag.TotalStaffCount ?? 0;
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">@role Operations Center</h1>
    <p style="color: var(--color-text-muted);">Real-time status overview and task tracking utility.</p>
</div>

@if (role == "FrontDesk")
{
    <!-- Front Desk Stats Counters -->
    <div class="grid-container grid-cols-3" style="margin-bottom: 30px;">
        <div class="cogstay-stat-card frontdesk">
            <div class="cogstay-stat-details">
                <p>Today's Bookings</p>
                <h3>@reservationsCount Bookings</h3>
            </div>
            <div class="cogstay-stat-icon">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
        </div>

        <div class="cogstay-stat-card frontdesk">
            <div class="cogstay-stat-details">
                <p>Active Stays</p>
                <h3>@activeStaysCount Guests</h3>
            </div>
            <div class="cogstay-stat-icon">
                <i class="fa-solid fa-users"></i>
            </div>
        </div>

        <div class="cogstay-stat-card frontdesk">
            <div class="cogstay-stat-details">
                <p>Available Rooms</p>
                <h3>@availableRoomsCount Rooms</h3>
            </div>
            <div class="cogstay-stat-icon">
                <i class="fa-solid fa-door-open"></i>
            </div>
        </div>
    </div>

    <div class="booking-checkout-container">
        <!-- Today's Queue List -->
        <div class="cogstay-card">
            <div class="cogstay-card-header">
                <h3 class="cogstay-card-title"><i class="fa-solid fa-clock"></i> Expected Arrivals Queue</h3>
                <span class="cogstay-badge info">@arrivalsList.Count() Pending Arrival</span>
            </div>
            <div class="cogstay-table-responsive">
                <table class="cogstay-table">
                    <thead>
                        <tr>
                            <th>Guest Name</th>
                            <th>Room Preferred</th>
                            <th>Check-In Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!arrivalsList.Any())
                        {
                            <tr>
                                <td colspan="5" style="text-align: center; color: var(--color-text-muted);">No pending expected arrivals found.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in arrivalsList)
                            {
                                <tr>
                                    <td><strong>@item.GuestName</strong></td>
                                    <td>Room @item.RoomNumber (@item.RoomType)</td>
                                    <td>@item.CheckInDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="cogstay-badge warning">@item.ReservationStatus</span></td>
                                    <td><a href="/CheckIn/CheckIn" class="btn btn-primary btn-sm">Check-In</a></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Quick Links -->
        <div>
            <div class="cogstay-card">
                <div class="cogstay-card-header">
                    <h3 class="cogstay-card-title"><i class="fa-solid fa-bolt"></i> Front Desk Shortcuts</h3>
                </div>
                <div class="cogstay-card-body" style="display: flex; flex-direction: column; gap: 12px;">
                    <a href="/Reservation/Create" class="btn btn-secondary" style="justify-content: flex-start; text-align: left;">
                        <i class="fa-solid fa-calendar-plus"></i> Create Reservation
                    </a>
                    <a href="/CheckIn/CheckOut" class="btn btn-secondary" style="justify-content: flex-start; text-align: left;">
                        <i class="fa-solid fa-sign-out-alt"></i> Guest Check-Out
                    </a>
                    <a href="/Room/CheckAvailability" class="btn btn-secondary" style="justify-content: flex-start; text-align: left;">
                        <i class="fa-solid fa-door-open"></i> Check Room Availability
                    </a>
                    <a href="/Billing/Index" class="btn btn-secondary" style="justify-content: flex-start; text-align: left;">
                        <i class="fa-solid fa-file-invoice-dollar"></i> Billing Operations
                    </a>
                    <a href="/Billing/History" class="btn btn-secondary" style="justify-content: flex-start; text-align: left;">
                        <i class="fa-solid fa-clock-rotate-left"></i> Payment History
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else if (role == "Housekeeping")
{
    <!-- Housekeeping Stats Counters -->
    <div class="grid-container grid-cols-3" style="margin-bottom: 30px;">
        <div class="cogstay-stat-card housekeeping">
            <div class="cogstay-stat-details">
                <p>Pending Tasks</p>
                <h3>@pendingTasksCount Tasks</h3>
            </div>
            <div class="cogstay-stat-icon">
                <i class="fa-solid fa-clock"></i>
            </div>
        </div>

        <div class="cogstay-stat-card housekeeping">
            <div class="cogstay-stat-details">
                <p>In Progress Tasks</p>
                <h3>@inProgressTasksCount Tasks</h3>
            </div>
            <div class="cogstay-stat-icon">
                <i class="fa-solid fa-spinner"></i>
            </div>
        </div>

        <div class="cogstay-stat-card housekeeping">
            <div class="cogstay-stat-details">
                <p>Completed Tasks</p>
                <h3>@completedTasksCount Tasks</h3>
            </div>
            <div class="cogstay-stat-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
        </div>
    </div>

    <!-- Active Tasks Queue -->
    <div class="cogstay-card">
        <div class="cogstay-card-header">
            <h3 class="cogstay-card-title"><i class="fa-solid fa-broom"></i> Active Room Cleaning Duties</h3>
            <span class="cogstay-badge warning">@housekeepingTasksList.Count() Active Duties</span>
        </div>
        <div class="cogstay-table-responsive">
            <table class="cogstay-table">
                <thead>
                    <tr>
                        <th>Room Number</th>
                        <th>Task Details</th>
                        <th>Status</th>
                        <th style="text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!housekeepingTasksList.Any())
                    {
                        <tr>
                            <td colspan="4" style="text-align: center; color: var(--color-text-muted);">No active housekeeping tasks.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var task in housekeepingTasksList)
                        {
                            string badgeClass = task.TaskStatus == CogStay.Domain.Enums.TaskStatus.Pending ? "danger" : "warning";
                            <tr>
                                <td><strong>Room @task.RoomNumber</strong></td>
                                <td>@task.TaskDescription</td>
                                <td><span class="cogstay-badge @badgeClass">@task.TaskStatus</span></td>
                                <td style="text-align: right;"><a asp-controller="Housekeeping" asp-action="Edit" asp-route-id="@task.TaskId" class="btn btn-primary btn-sm">Update</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (role == "Manager")
{
    <!-- Manager Stats Counters -->
    <div class="grid-container grid-cols-4" style="margin-bottom: 30px;">
        <div class="cogstay-stat-card manager">
            <div class="cogstay-stat-details">
                <p>Available Rooms</p>
                <h3>@availableRoomsCount Rooms</h3>
            </div>
            <div class="cogstay-stat-icon">
                <i class="fa-solid fa-door-open"></i>
            </div>
        </div>

        <div class="cogstay-stat-card manager">
            <div class="cogstay-stat-details">
                <p>Active Reservations</p>
                <h3>@reservationsCount Bookings</h3>
            </div>
            <div class="cogstay-stat-icon">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
        </div>

        <div class="cogstay-stat-card manager">
            <div class="cogstay-stat-details">
                <p>Active Stays</p>
                <h3>@activeStaysCount Stays</h3>
            </div>
            <div class="cogstay-stat-icon">
                <i class="fa-solid fa-key"></i>
            </div>
        </div>

        <div class="cogstay-stat-card manager">
            <div class="cogstay-stat-details">
                <p>Pending Payments</p>
                <h3>@pendingPaymentAmount.ToString("C")</h3>
            </div>
            <div class="cogstay-stat-icon">
                <i class="fa-solid fa-file-invoice-dollar"></i>
            </div>
        </div>
    </div>

    <div class="booking-checkout-container">
        <!-- Status Overview -->
        <div class="cogstay-card">
            <div class="cogstay-card-header">
                <h3 class="cogstay-card-title"><i class="fa-solid fa-chart-line"></i> Operations Summary</h3>
            </div>
            <div class="cogstay-card-body">
                <div class="manager-kpi-row">
                    <span>Available / Total Rooms</span>
                    <strong>@availableRoomsCount / @totalRoomsCount Rooms</strong>
                </div>
                <div class="manager-kpi-row">
                    <span>Housekeeping Active Tasks</span>
                    <strong>@pendingTasksCount Pending / @inProgressTasksCount In-Progress</strong>
                </div>
                <div class="manager-kpi-row">
                    <span>Outstanding Invoices</span>
                    <strong>@pendingPaymentAmount.ToString("C") (@pendingBillsCount pending)</strong>
                </div>
            </div>
        </div>

        <!-- Manager Quick Links -->
        <div class="cogstay-card">
            <div class="cogstay-card-header">
                <h3 class="cogstay-card-title"><i class="fa-solid fa-gears"></i> Review Operations</h3>
            </div>
            <div class="cogstay-card-body" style="display: flex; flex-direction: column; gap: 12px;">
                <a href="/Room/Index" class="btn btn-secondary" style="justify-content: flex-start;"><i class="fa-solid fa-door-closed"></i> Rooms Management</a>
                <a href="/Reservation/Index" class="btn btn-secondary" style="justify-content: flex-start;"><i class="fa-solid fa-list-check"></i> Reservations List</a>
                <a href="/Billing/Index" class="btn btn-secondary" style="justify-content: flex-start;"><i class="fa-solid fa-wallet"></i> Billing History</a>
            </div>
        </div>
    </div>
}
else if (role == "Admin")
{
    <!-- Admin Stats Counters -->
    <div class="grid-container grid-cols-2" style="margin-bottom: 30px;">
        <div class="cogstay-stat-card admin">
            <div class="cogstay-stat-details">
                <p>Total Rooms</p>
                <h3>@totalRoomsCount Rooms</h3>
            </div>
            <div class="cogstay-stat-icon">
                <i class="fa-solid fa-door-open"></i>
            </div>
        </div>

        <div class="cogstay-stat-card admin">
            <div class="cogstay-stat-details">
                <p>Total Staff Members</p>
                <h3>@totalStaffCount Staff</h3>
            </div>
            <div class="cogstay-stat-icon">
                <i class="fa-solid fa-users-gear"></i>
            </div>
        </div>
    </div>

    <div class="booking-checkout-container">
        <!-- Overview of administrative actions -->
        <div class="cogstay-card">
            <div class="cogstay-card-header">
                <h3 class="cogstay-card-title"><i class="fa-solid fa-user-shield"></i> Administration Tools</h3>
            </div>
            <div class="cogstay-card-body" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px;">
                <a href="/Staff/Index" class="btn btn-secondary" style="justify-content: flex-start;"><i class="fa-solid fa-users"></i> Staff CRUD Portal</a>
                <a href="/Room/Index" class="btn btn-secondary" style="justify-content: flex-start;"><i class="fa-solid fa-door-open"></i> Add/Edit Room Catalog</a>
            </div>
        </div>

        <div class="cogstay-card">
            <div class="cogstay-card-header">
                <h3 class="cogstay-card-title"><i class="fa-solid fa-info-circle"></i> Quick Admin Info</h3>
            </div>
            <div class="cogstay-card-body" style="font-size: 13.5px; line-height: 1.5; color: var(--color-text-muted);">
                Welcome to the administrative control dashboard. Manage staff profiles and room inventory in real time.
            </div>
        </div>
    </div>
}
