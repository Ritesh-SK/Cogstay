@model IEnumerable<CogStay.Application.DTOs.StaffResponseDTO>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Staff Management";
    ViewData["Role"] = "Admin";
}

<div class="table-action-header">
    <div>
        <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Corporate Staff Directory</h1>
        <p style="color: var(--color-text-muted);">Manage corporate staff profiles, roles, and accessibility permissions.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-user-plus"></i> Add Staff Member</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="cogstay-card">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-users"></i> CogStay Staff Members</h3>
        <span class="cogstay-badge success">@Model.Count() Staff Profiles</span>
    </div>
    <div class="cogstay-table-responsive">
        <table class="cogstay-table">
            <thead>
                <tr>
                    <th>Staff Name</th>
                    <th>Email Address</th>
                    <th>Phone Number</th>
                    <th>Assigned Role</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--color-text-muted);">No staff records found. Add your first staff member.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.FullName</strong></td>
                            <td>@item.Email</td>
                            <td>@item.PhoneNumber</td>
                            <td><span class="cogstay-badge info">@item.Role</span></td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="cogstay-badge success">Active</span>
                                }
                                else
                                {
                                    <span class="cogstay-badge danger">Inactive</span>
                                }
                            </td>
                            <td style="text-align: right; display: flex; gap: 8px; justify-content: flex-end;">
                                <a asp-action="Details" asp-route-id="@item.StaffId" class="btn btn-secondary btn-sm">View</a>
                                <a asp-action="Edit" asp-route-id="@item.StaffId" class="btn btn-secondary btn-sm" style="border-color: var(--color-warning); color: var(--color-warning);"><i class="fa-solid fa-user-pen"></i> Update</a>
                                <a asp-action="Delete" asp-route-id="@item.StaffId" class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i> Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
