@{
    var role = ViewData["Role"]?.ToString() ?? "";
    var portalName = "CogStay Portal";
    if (role == "Guest") { portalName = "CogStay Guest Portal"; }
    else if (role == "Admin") { portalName = "CogStay Administration"; }
    else if (role == "Manager") { portalName = "CogStay Management Console"; }
    else if (role == "FrontDesk") { portalName = "CogStay Front Desk Operations"; }
    else if (role == "Housekeeping") { portalName = "CogStay Housekeeping Services"; }
}

<header class="cogstay-navbar">
    <div class="cogstay-nav-left">
        <button class="cogstay-sidebar-toggle" id="cogstaySidebarToggleBtn" aria-label="Toggle Sidebar">
            <i class="fa-solid fa-bars"></i>
        </button>
        <h2 class="cogstay-page-title">@ViewData["Title"]</h2>
    </div>
    <div class="cogstay-nav-right">
        <span class="cogstay-portal-badge">@portalName</span>
        <div class="cogstay-notification-bell" id="cogstayNotificationBellBtn" title="Notifications">
            <i class="fa-regular fa-bell"></i>
            <span class="cogstay-notification-badge" id="cogstayNotificationBadge" style="display: none;">0</span>

            <!-- Notification Popover Dropdown -->
            <div class="cogstay-notification-dropdown" id="cogstayNotificationDropdown">
                <div class="cogstay-notification-header">
                    <div class="cogstay-notification-title">
                        <i class="fa-solid fa-bell" style="color: var(--color-accent);"></i> Real-Time Alerts
                    </div>
                    <button type="button" class="cogstay-mark-read-btn" id="cogstayMarkAllReadBtn">
                        <i class="fa-solid fa-check-double"></i> Mark all read
                    </button>
                </div>
                <div class="cogstay-notification-body" id="cogstayNotificationBody">
                    <div class="cogstay-notification-state-container">
                        <div class="cogstay-loading-spinner">
                            <i class="fa-solid fa-circle-notch fa-spin"></i>
                        </div>
                        <span class="cogstay-loading-text">Fetching notifications...</span>
                    </div>
                </div>
                <div class="cogstay-notification-footer">
                    <i class="fa-solid fa-shield-halved" style="color: var(--color-accent); margin-right: 4px;"></i> Secure Live Notification Engine
                </div>
            </div>
        </div>
    </div>
</header>
