@model CogStayMVC.DTOs.HousekeepingTaskResponseDTO
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Housekeeping Task Details";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Admin" : roleParam;
    }
    string badgeClass = Model.TaskStatus switch
    {
        CogStayMVC.Enums.TaskStatus.Pending => "danger",
        CogStayMVC.Enums.TaskStatus.InProgress => "warning",
        CogStayMVC.Enums.TaskStatus.Completed => "success",
        _ => "secondary"
    };
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Housekeeping Duty Record</h1>
    <p style="color: var(--color-text-muted);">View assignment instructions and progress records for this housekeeping task.</p>
</div>

<div class="booking-checkout-container">
    <div class="cogstay-card">
        <div class="cogstay-card-header">
            <h3 class="cogstay-card-title"><i class="fa-solid fa-broom"></i> Room @Model.RoomNumber Task Assignment</h3>
            <span class="cogstay-badge @badgeClass">@Model.TaskStatus</span>
        </div>
        <div class="cogstay-card-body">
            <div class="grid-container grid-cols-2" style="gap: 15px; margin-bottom: 25px;">
                <div>
                    <span style="font-size: 13px; color: var(--color-text-muted); text-transform: uppercase;">Room Unit</span>
                    <p style="font-size: 16px; font-weight: 600; margin-top: 3px;">Room @Model.RoomNumber</p>
                </div>
                <div>
                    <span style="font-size: 13px; color: var(--color-text-muted); text-transform: uppercase;">Task Status</span>
                    <p style="font-size: 16px; font-weight: 600; margin-top: 3px;">@Model.TaskStatus</p>
                </div>
            </div>

            <div style="border-top: 1px solid var(--color-border); padding-top: 15px; margin-bottom: 20px;">
                <span style="font-size: 13px; color: var(--color-text-muted); text-transform: uppercase; font-weight: 600; display: block; margin-bottom: 5px;">Duty Description Instructions</span>
                <p style="font-size: 14.5px; line-height: 1.5;">@Model.TaskDescription</p>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; border-top: 1px solid var(--color-border); padding-top: 20px;">
                <a asp-action="Index" class="btn btn-secondary">Back to Task Board</a>
                <a asp-action="Edit" asp-route-id="@Model.TaskId" class="btn btn-primary">Update Task Status</a>
            </div>
        </div>
    </div>
</div>
