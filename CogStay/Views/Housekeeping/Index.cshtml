@model IEnumerable<CogStayMVC.DTOs.HousekeepingTaskResponseDTO>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Housekeeping" : roleParam;
    }
    var role = ViewData["Role"]?.ToString() ?? "Housekeeping";
    ViewData["Title"] = "Housekeeping Duties";
}

<div class="table-action-header">
    <div>
        <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Housekeeping & Maintenance Task Board</h1>
        <p style="color: var(--color-text-muted);">Coordinate and monitor room status, cleaning schedules, and service requests.</p>
    </div>
    @if (role == "Admin" || role == "Manager" || role == "Housekeeping" || role == "FrontDesk")
    {
        <div>
            <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Assign New Cleaning Task</a>
        </div>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="cogstay-card">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-spray-can-sparkles"></i> Room Task Queue</h3>
        <span class="cogstay-badge warning">@Model.Count() Tasks Active</span>
    </div>
    <div class="cogstay-table-responsive">
        <table class="cogstay-table">
            <thead>
                <tr>
                    <th>Room</th>
                    <th>Guest</th>
                    <th>Task</th>
                    <th>Status</th>
                    <th>Assigned Staff</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--color-text-muted);">No housekeeping tasks found.</td>
                    </tr>
                }
                else
                {
                    var roomGuestMap = ViewBag.RoomGuestMap as Dictionary<string, string> ?? new Dictionary<string, string>();
                    foreach (var item in Model)
                    {
                        string badgeClass = item.TaskStatus switch
                        {
                            CogStayMVC.Enums.TaskStatus.Pending => "danger",
                            CogStayMVC.Enums.TaskStatus.InProgress => "warning",
                            CogStayMVC.Enums.TaskStatus.Completed => "success",
                            _ => "secondary"
                        };

                        // Extract Task Type and Clean Description
                        string taskType = "Cleaning";
                        string cleanDescription = item.TaskDescription;
                        if (item.TaskDescription.StartsWith("[") && item.TaskDescription.Contains("]"))
                        {
                            int index = item.TaskDescription.IndexOf("]");
                            taskType = item.TaskDescription.Substring(1, index - 1);
                            cleanDescription = item.TaskDescription.Substring(index + 1).Trim();
                        }

                        // Find guest name
                        string guestName = roomGuestMap.TryGetValue(item.RoomNumber, out var name) ? name : "No Active Guest";

                        <tr>
                            <td><strong>Room @item.RoomNumber</strong></td>
                            <td>@guestName</td>
                            <td>
                                <strong style="color: var(--color-primary-dark);">@taskType</strong>
                                <br />
                                <span style="font-size: 12px; color: var(--color-text-muted);">@cleanDescription</span>
                            </td>
                            <td><span class="cogstay-badge @badgeClass">@item.TaskStatus</span></td>
                            <td>Housekeeping Staff</td>
                            <td style="text-align: right; display: flex; gap: 8px; justify-content: flex-end; align-items: center;">
                                <a asp-action="Details" asp-route-id="@item.TaskId" class="btn btn-secondary btn-sm"><i class="fa-solid fa-circle-info"></i> Details</a>
                                <a asp-action="Edit" asp-route-id="@item.TaskId" class="btn btn-secondary btn-sm" style="border-color: var(--color-warning); color: var(--color-warning);"><i class="fa-solid fa-pen-to-square"></i> Update Status</a>
                                <form asp-action="Delete" asp-route-id="@item.TaskId" method="post" style="display: contents;" onsubmit="return confirm('Delete this housekeeping task?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-secondary btn-sm" style="border-color: var(--color-danger); color: var(--color-danger);"><i class="fa-solid fa-trash"></i> Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
