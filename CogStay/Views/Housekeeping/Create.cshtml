@model CogStayMVC.DTOs.CreateHousekeepingTaskDTO
@using CogStayMVC.DTOs
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Assign Housekeeping Task";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Admin" : roleParam;
    }
    var rooms = ViewBag.Rooms as IEnumerable<RoomResponseDTO> ?? Enumerable.Empty<RoomResponseDTO>();
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Assign Operational Room Task</h1>
    <p style="color: var(--color-text-muted);">Assign room cleanup, maintenance repairs, or guest amenity requests to housekeeping personnel.</p>
</div>

<div class="cogstay-card" style="max-width: 800px;">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-plus"></i> Task Assignment Form</h3>
    </div>
    <div class="cogstay-card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="cogstay-form-group">
                <label class="cogstay-form-label" asp-for="RoomId">Room Allocation</label>
                <select asp-for="RoomId" class="cogstay-form-control" required>
                    <option value="">-- Select Room --</option>
                    @foreach (var room in rooms)
                    {
                        <option value="@room.RoomId">Room @room.RoomNumber (@room.RoomType - @room.Status)</option>
                    }
                </select>
                <span asp-validation-for="RoomId" class="text-danger"></span>
            </div>

            <div class="cogstay-form-group">
                <label class="cogstay-form-label" for="TaskType">Task / Service Type</label>
                <select id="TaskType" name="TaskType" class="cogstay-form-control" required>
                    <option value="">-- Select Service Type --</option>
                    <option value="Cleaning">Cleaning</option>
                    <option value="Spa">Spa</option>
                    <option value="Food Service">Food Service</option>
                    <option value="Room Service">Room Service</option>
                    <option value="Laundry">Laundry</option>
                    <option value="Maintenance">Maintenance</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="cogstay-form-group">
                <label class="cogstay-form-label" asp-for="TaskDescription">Detailed Task Description / Notes</label>
                <textarea asp-for="TaskDescription" class="cogstay-form-control" rows="4" placeholder="Description of cleaning duties, maintenance problems, or guest services..." required></textarea>
                <span asp-validation-for="TaskDescription" class="text-danger"></span>
            </div>

            <div style="display: flex; gap: 15px; justify-content: flex-end; margin-top: 20px;">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Assign Task</button>
            </div>
        </form>
    </div>
</div>
