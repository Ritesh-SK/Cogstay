@model IEnumerable<CogStay.Application.DTOs.RoomResponseDTO>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Room Catalog";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Admin" : roleParam;
    }
}

<div class="table-action-header">
    <div>
        <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Room Inventory Catalog</h1>
        <p style="color: var(--color-text-muted);">Manage room allocations, pricing per night, and maintenance statuses.</p>
    </div>
    <div style="display: flex; gap: 10px;">
        <a asp-action="CheckAvailability" class="btn btn-secondary"><i class="fa-solid fa-magnifying-glass"></i> Check Availability</a>
        <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Add New Room</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="cogstay-card">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-door-open"></i> All Guest Rooms</h3>
        <span class="cogstay-badge info">@Model.Count() Rooms Configured</span>
    </div>
    <div class="cogstay-table-responsive">
        <table class="cogstay-table">
            <thead>
                <tr>
                    <th>Room Number</th>
                    <th>Room Type</th>
                    <th>Price Per Night</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align: center; color: var(--color-text-muted);">No rooms found. Add your first room using the button above.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        string badgeClass = item.Status switch
                        {
                            RoomStatus.Available => "success",
                            RoomStatus.Occupied => "danger",
                            RoomStatus.NeedsCleaning => "warning",
                            RoomStatus.Maintenance => "secondary",
                            _ => "info"
                        };

                        <tr>
                            <td><strong>@item.RoomNumber</strong></td>
                            <td>@item.RoomType</td>
                            <td>@item.PricePerNight.ToString("C")</td>
                            <td><span class="cogstay-badge @badgeClass">@item.Status</span></td>
                            <td style="text-align: right; display: flex; gap: 8px; justify-content: flex-end;">
                                <a asp-action="Details" asp-route-id="@item.RoomId" class="btn btn-secondary btn-sm">View</a>
                                <a asp-action="Edit" asp-route-id="@item.RoomId" class="btn btn-secondary btn-sm" style="border-color: var(--color-warning); color: var(--color-warning);"><i class="fa-solid fa-pen-to-square"></i> Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.RoomId" method="post" style="display:inline;" onsubmit="return confirm('Delete room @item.RoomNumber?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-secondary btn-sm" style="border-color: var(--color-danger); color: var(--color-danger);">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
