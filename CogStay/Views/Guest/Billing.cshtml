@model IEnumerable<CogStay.Application.DTOs.BillingResponseDTO>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Billing & Invoices";
    ViewData["Role"] = "Guest";
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Billing Statements</h1>
    <p style="color: var(--color-text-muted);">Manage payments and review historical invoices and transaction receipts.</p>
</div>

<div class="cogstay-card">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-file-invoice-dollar"></i> Invoice Statements</h3>
        <span class="cogstay-badge info">@Model.Count() Statements</span>
    </div>
    <div class="cogstay-table-responsive">
        <table class="cogstay-table">
            <thead>
                <tr>
                    <th>Invoice Number</th>
                    <th>Guest / Room</th>
                    <th>Amount</th>
                    <th>Payment Status</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align: center; color: var(--color-text-muted);">No billing invoices found.</td>
                    </tr>
                }
                else
                {
                    foreach (var bill in Model)
                    {
                        string badgeClass = bill.PaymentStatus == CogStay.Domain.Enums.PaymentStatus.Paid ? "success" : "danger";
                        <tr>
                            <td><strong>#INV-@bill.BillId</strong></td>
                            <td>Room @bill.RoomNumber (@bill.GuestName)</td>
                            <td>@bill.TotalAmount.ToString("C")</td>
                            <td><span class="cogstay-badge @badgeClass">@bill.PaymentStatus</span></td>
                            <td>@bill.Remarks</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
