@model CogStay.Application.DTOs.CreateReservationDTO
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Book Room";
    ViewData["Role"] = "Guest";
    var availableRooms = ViewBag.AvailableRooms as IEnumerable<CogStay.Application.DTOs.RoomResponseDTO> ?? Enumerable.Empty<CogStay.Application.DTOs.RoomResponseDTO>();
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Reserve Your Stay</h1>
    <p style="color: var(--color-text-muted);">Please select your room and dates to secure your reservation.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="booking-checkout-container">
    <!-- Left Column: Booking Form -->
    <div class="cogstay-card">
        <div class="cogstay-card-header">
            <h3 class="cogstay-card-title"><i class="fa-solid fa-calendar-days"></i> Booking Configuration</h3>
        </div>
        <div class="cogstay-card-body">
            <form asp-action="BookRoom" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="GuestId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="RoomId">Select Available Room</label>
                    <select asp-for="RoomId" class="cogstay-form-control" required>
                        <option value="">-- Choose Room --</option>
                        @foreach (var room in availableRooms)
                        {
                            <option value="@room.RoomId">Room @room.RoomNumber - @room.RoomType (@room.PricePerNight.ToString("C") / Night)</option>
                        }
                    </select>
                    <span asp-validation-for="RoomId" class="text-danger"></span>
                </div>

                <div class="cogstay-form-row">
                    <div class="cogstay-form-group">
                        <label class="cogstay-form-label" asp-for="CheckInDate">Check-In Date</label>
                        <input asp-for="CheckInDate" type="date" class="cogstay-form-control" required />
                        <span asp-validation-for="CheckInDate" class="text-danger"></span>
                    </div>
                    <div class="cogstay-form-group">
                        <label class="cogstay-form-label" asp-for="CheckOutDate">Check-Out Date</label>
                        <input asp-for="CheckOutDate" type="date" class="cogstay-form-control" required />
                        <span asp-validation-for="CheckOutDate" class="text-danger"></span>
                    </div>
                </div>

                <div style="margin-top: 20px;">
                    <button type="submit" class="btn btn-primary" style="width: 100%;">Confirm Booking Reservation</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Right Column: Info Card -->
    <div class="cogstay-card booking-summary-card">
        <div class="cogstay-card-header">
            <h3 class="cogstay-card-title"><i class="fa-solid fa-circle-info"></i> Reservation Information</h3>
        </div>
        <div class="cogstay-card-body">
            <p style="font-size: 14px; color: var(--color-text-muted); line-height: 1.6; margin-bottom: 20px;">
                Select from our currently available rooms catalog. Your reservation will be automatically assigned and set to <strong>Booked</strong> status upon confirmation.
            </p>
            
            <div style="background-color: var(--color-bg); border-radius: var(--border-radius); padding: 12px; font-size: 12.5px; color: var(--color-text-muted); line-height: 1.4;">
                <i class="fa-solid fa-shield-halved" style="color: var(--color-accent);"></i> Secure stay verification. Payment invoice will be generated upon check-in and checkout processing.
            </div>
        </div>
    </div>
</div>
