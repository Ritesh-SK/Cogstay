@model IEnumerable<CogStayMVC.DTOs.ReservationResponseDTO>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Booking History";
    ViewData["Role"] = "Guest";
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Stay History Archive</h1>
    <p style="color: var(--color-text-muted);">View records of all your past stays and completed reservations at CogStay.</p>
</div>

<div class="cogstay-card">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-clock-rotate-left"></i> Completed Reservations</h3>
        <span class="cogstay-badge info">@Model.Count() Total Reservations</span>
    </div>
    <div class="cogstay-table-responsive">
        <table class="cogstay-table">
            <thead>
                <tr>
                    <th>Reservation ID</th>
                    <th>Room Type & Number</th>
                    <th>Check-In</th>
                    <th>Check-Out</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align: center; color: var(--color-text-muted);">No reservation history found.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        string badgeClass = item.ReservationStatus == CogStayMVC.Enums.ReservationStatus.Booked ? "success" : "secondary";
                        <tr>
                            <td><strong>#RES-@item.ReservationId</strong></td>
                            <td>Room @item.RoomNumber (@item.RoomType)</td>
                            <td>@item.CheckInDate.ToString("MMM dd, yyyy")</td>
                            <td>@item.CheckOutDate.ToString("MMM dd, yyyy")</td>
                            <td><span class="cogstay-badge @badgeClass">@item.ReservationStatus</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
