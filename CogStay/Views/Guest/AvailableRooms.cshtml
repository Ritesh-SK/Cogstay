@model IEnumerable<CogStay.Application.DTOs.RoomResponseDTO>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Available Rooms";
    ViewData["Role"] = "Guest";
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Explore Available Rooms</h1>
    <p style="color: var(--color-text-muted);">Browse our catalog of available luxury suites and standard rooms.</p>
</div>

<!-- Rooms Table Catalog -->
<div class="cogstay-card">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-hotel"></i> Available Rooms Catalog</h3>
        <span class="cogstay-badge success">@Model.Count() Rooms Available</span>
    </div>
    <div class="cogstay-table-responsive">
        <table class="cogstay-table">
            <thead>
                <tr>
                    <th>Room Number</th>
                    <th>Room Type</th>
                    <th>Price Per Night</th>
                    <th>Availability Status</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align: center; color: var(--color-text-muted);">No rooms currently available for booking.</td>
                    </tr>
                }
                else
                {
                    foreach (var room in Model)
                    {
                        <tr>
                            <td><strong>@room.RoomNumber</strong></td>
                            <td>@room.RoomType</td>
                            <td>@room.PricePerNight.ToString("C")</td>
                            <td><span class="cogstay-badge success">Available</span></td>
                            <td style="text-align: right;">
                                <a asp-controller="Guest" asp-action="BookRoom" asp-route-roomId="@room.RoomId" class="btn btn-primary btn-sm">Book</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
