@model CogStayMVC.DTOs.CreateFeedbackDTO
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Submit Guest Feedback";
    ViewData["Role"] = "Guest";
}

<div style="max-width: 800px; margin: 0 auto; padding: 20px 0;">
    <div class="cogstay-card">
        <div class="cogstay-card-header">
            <h3 class="cogstay-card-title"><i class="fa-solid fa-star"></i> Submit Guest Feedback & Review</h3>
        </div>
        <div class="cogstay-card-body" style="padding: 30px;">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <input type="hidden" asp-for="GuestId" />
                <input type="hidden" asp-for="ReservationId" />

                <div class="cogstay-form-group">
                    <label asp-for="Rating" class="cogstay-form-label">Rating (1 to 5 Stars)</label>
                    <select asp-for="Rating" class="cogstay-form-control">
                        <option value="5">★★★★★ (5 - Excellent)</option>
                        <option value="4">★★★★☆ (4 - Good)</option>
                        <option value="3">★★★☆☆ (3 - Average)</option>
                        <option value="2">★★☆☆☆ (2 - Poor)</option>
                        <option value="1">★☆☆☆☆ (1 - Very Bad)</option>
                    </select>
                    <span asp-validation-for="Rating" class="text-danger"></span>
                </div>

                <div class="cogstay-form-group">
                    <label asp-for="Comments" class="cogstay-form-label">Your Review & Comments</label>
                    <textarea asp-for="Comments" class="cogstay-form-control" rows="5" placeholder="Tell us about your stay experience..." required></textarea>
                    <span asp-validation-for="Comments" class="text-danger"></span>
                </div>

                <div style="display: flex; justify-content: space-between; margin-top: 20px; align-items: center;">
                    <a asp-controller="Guest" asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
                    <button type="submit" class="btn btn-primary">Submit Feedback</button>
                </div>
            </form>
        </div>
    </div>
</div>
