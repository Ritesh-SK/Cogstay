@model CogStayMVC.DTOs.ProcessPaymentDTO
@using CogStayMVC.DTOs
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Process Payment";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Admin" : roleParam;
    }
    var bill = ViewBag.Bill as BillingResponseDTO;
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Process Invoice Payment</h1>
    <p style="color: var(--color-text-muted);">Accept payment for guest stay invoice and complete guest checkout.</p>
</div>

<div class="cogstay-card" style="max-width: 800px;">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-credit-card"></i> Payment Settlement</h3>
    </div>
    <div class="cogstay-card-body">
        <form asp-action="Payment" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="BillId" />

            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Bill Reference</label>
                    <input type="text" class="cogstay-form-control" value="#BILL-@(bill?.BillId)" readonly />
                </div>
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Guest & Room</label>
                    <input type="text" class="cogstay-form-control" value="@(bill?.GuestName) (Room @(bill?.RoomNumber))" readonly />
                </div>
            </div>

            <div class="cogstay-form-group">
                <label class="cogstay-form-label">Total Amount Payable</label>
                <input type="text" class="cogstay-form-control" value="@(bill?.TotalAmount.ToString("C"))" readonly style="font-weight: 700; font-size: 18px; color: var(--color-primary-dark);" />
            </div>

            <div class="cogstay-form-group">
                <label class="cogstay-form-label" asp-for="Remarks">Payment Notes / Method Remarks</label>
                <input asp-for="Remarks" type="text" class="cogstay-form-control" placeholder="E.g., Paid via Credit Card at Front Desk" required />
                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>

            <div style="display: flex; gap: 15px; justify-content: flex-end; margin-top: 20px;">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check-circle"></i> Confirm & Process Payment</button>
            </div>
        </form>
    </div>
</div>
