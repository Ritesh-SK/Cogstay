@model CogStayMVC.DTOs.CheckOutDTO
@using CogStayMVC.DTOs
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Guest Check-Out";
    ViewData["Role"] = "FrontDesk";
    var stays = ViewBag.Stays as IEnumerable<StayRecordResponseDTO> ?? Enumerable.Empty<StayRecordResponseDTO>();
    var activeStays = stays.Where(s => !s.ActualCheckOut.HasValue).ToList();
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Process Guest Departure</h1>
    <p style="color: var(--color-text-muted);">Initiate checkout and proceed to billing payment settlement.</p>
</div>

<div class="cogstay-card" style="max-width: 800px;">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-sign-out-alt"></i> Select Guest Stay for Departure</h3>
    </div>
    <div class="cogstay-card-body">
        <form asp-action="CheckOut" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="cogstay-form-group">
                <label class="cogstay-form-label" asp-for="StayId">Active Guest Stay</label>
                <select asp-for="StayId" class="cogstay-form-control" required>
                    <option value="">-- Select Active Stay --</option>
                    @foreach (var s in activeStays)
                    {
                        <option value="@s.StayId">#STAY-@s.StayId - @s.GuestName (Room @s.RoomNumber)</option>
                    }
                </select>
                <span asp-validation-for="StayId" class="text-danger"></span>
            </div>

            <div style="display: flex; gap: 15px; justify-content: flex-end; margin-top: 20px;">
                <a asp-action="ActiveStays" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Proceed to Billing & Checkout</button>
            </div>
        </form>
    </div>
</div>
