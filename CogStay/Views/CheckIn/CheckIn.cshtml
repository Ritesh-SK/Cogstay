@model CogStay.Application.DTOs.CreateCheckInDTO
@using CogStay.Application.DTOs
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Guest Check-In";
    ViewData["Role"] = "FrontDesk";
    var reservations = ViewBag.Reservations as IEnumerable<ReservationResponseDTO> ?? Enumerable.Empty<ReservationResponseDTO>();
    var bookedReservations = reservations.Where(r => r.ReservationStatus == CogStay.Domain.Enums.ReservationStatus.Confirmed).ToList();
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Process Guest Arrival</h1>
    <p style="color: var(--color-text-muted);">Allocate keys and register actual check-in timestamps for arriving guests.</p>
</div>

<div class="booking-checkout-container">
    <div class="cogstay-card">
        <div class="cogstay-card-header">
            <h3 class="cogstay-card-title"><i class="fa-solid fa-sign-in-alt"></i> Guest Check-In Registration</h3>
        </div>
        <div class="cogstay-card-body">
            <form asp-action="CheckIn" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="ReservationId">Select Active Reservation Booking</label>
                    <select asp-for="ReservationId" class="cogstay-form-control" required>
                        <option value="">-- Select Reservation --</option>
                        @foreach (var res in bookedReservations)
                        {
                            <option value="@res.ReservationId">#RES-@res.ReservationId - @res.GuestName (Room @res.RoomNumber - @res.RoomType)</option>
                        }
                    </select>
                    <span asp-validation-for="ReservationId" class="text-danger"></span>
                </div>

                <div style="display: flex; gap: 15px; justify-content: flex-end; margin-top: 20px;">
                    <a asp-action="ActiveStays" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Process Check-In</button>
                </div>
            </form>
        </div>
    </div>
</div>
