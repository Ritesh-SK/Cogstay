@model CogStayMVC.DTOs.CreateFeedbackDTO
@{
    ViewData["Title"] = "Submit Guest Feedback";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Submit Guest Feedback & Review</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <input type="hidden" asp-for="GuestId" />
                        <input type="hidden" asp-for="ReservationId" />

                        <div class="form-group mb-3">
                            <label asp-for="Rating" class="form-label font-weight-bold">Rating (1 to 5 Stars)</label>
                            <select asp-for="Rating" class="form-control">
                                <option value="5">★★★★★ (5 - Excellent)</option>
                                <option value="4">★★★★☆ (4 - Good)</option>
                                <option value="3">★★★☆☆ (3 - Average)</option>
                                <option value="2">★★☆☆☆ (2 - Poor)</option>
                                <option value="1">★☆☆☆☆ (1 - Very Bad)</option>
                            </select>
                            <span asp-validation-for="Rating" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Comments" class="form-label font-weight-bold">Your Review & Comments</label>
                            <textarea asp-for="Comments" class="form-control" rows="4" placeholder="Tell us about your stay experience..."></textarea>
                            <span asp-validation-for="Comments" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Guest" asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
                            <button type="submit" class="btn btn-success px-4">Submit Feedback</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
