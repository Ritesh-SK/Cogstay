@model IEnumerable<CogStayMVC.DTOs.FeedbackResponseDTO>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Guest Feedback & Reviews";
    ViewData["Role"] = "Manager";
}

<div class="table-action-header">
    <div>
        <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Guest Feedbacks & Ratings</h1>
        <p style="color: var(--color-text-muted);">Reviews submitted by guests after their stays.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="cogstay-card">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-star"></i> Submitted Reviews</h3>
        <span class="cogstay-badge info">@Model.Count() Reviews</span>
    </div>
    <div class="cogstay-table-responsive">
        <table class="cogstay-table">
            <thead>
                <tr>
                    <th>Feedback ID</th>
                    <th>Guest Name</th>
                    <th>Rating</th>
                    <th>Comments</th>
                    <th>Date Submitted</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--color-text-muted);">No feedback records found.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>#FB-@item.FeedbackId</strong></td>
                            <td>@item.GuestName</td>
                            <td>
                                <span style="color: var(--color-accent); font-weight: bold;">
                                    @for (int i = 0; i < item.Rating; i++)
                                    {
                                        <span>★</span>
                                    }
                                    @for (int i = item.Rating; i < 5; i++)
                                    {
                                        <span style="color: #ccc;">★</span>
                                    }
                                    <span style="color: var(--color-text-muted); font-size: 13px; font-weight: normal; margin-left: 5px;">(@item.Rating/5)</span>
                                </span>
                            </td>
                            <td>@item.Comments</td>
                            <td>@item.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td style="text-align: right;">
                                <form asp-action="Delete" asp-route-id="@item.FeedbackId" method="post" style="display:inline;" onsubmit="return confirm('Delete feedback #FB-@item.FeedbackId?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-secondary btn-sm" style="border-color: var(--color-danger); color: var(--color-danger);">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
