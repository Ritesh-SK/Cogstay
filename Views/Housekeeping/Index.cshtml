@model IEnumerable<CogStayMVC.DTOs.HousekeepingTaskResponseDTO>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Housekeeping" : roleParam;
    }
    var role = ViewData["Role"]?.ToString() ?? "Housekeeping";
    ViewData["Title"] = "Housekeeping Duties";
}

<div class="table-action-header">
    <div>
        <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Housekeeping & Maintenance Task Board</h1>
        <p style="color: var(--color-text-muted);">Coordinate and monitor room status, cleaning schedules, and service requests.</p>
    </div>
    @if (role == "Admin" || role == "Manager" || role == "Housekeeping" || role == "FrontDesk")
    {
        <div>
            <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Assign New Cleaning Task</a>
        </div>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="cogstay-card">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-spray-can-sparkles"></i> Room Task Queue</h3>
        <span class="cogstay-badge warning">@Model.Count() Tasks Active</span>
    </div>
    <div class="cogstay-table-responsive">
        <table class="cogstay-table">
            <thead>
                <tr>
                    <th>Room</th>
                    <th>Task Description</th>
                    <th>Task Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" style="text-align: center; color: var(--color-text-muted);">No housekeeping tasks found.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        string badgeClass = item.TaskStatus switch
                        {
                            CogStayMVC.Enums.TaskStatus.Pending => "danger",
                            CogStayMVC.Enums.TaskStatus.InProgress => "warning",
                            CogStayMVC.Enums.TaskStatus.Completed => "success",
                            _ => "secondary"
                        };

                        <tr>
                            <td><strong>Room @item.RoomNumber</strong></td>
                            <td>@item.TaskDescription</td>
                            <td><span class="cogstay-badge @badgeClass">@item.TaskStatus</span></td>
                            <td style="text-align: right; display: flex; gap: 8px; justify-content: flex-end; align-items: center;">
                                <a asp-action="Details" asp-route-id="@item.TaskId" class="btn btn-secondary btn-sm" style="display: inline-flex; align-items: center; justify-content: center; height: 32px; box-sizing: border-box;"><i class="fa-solid fa-circle-info"></i> Details</a>
                                <a asp-action="Edit" asp-route-id="@item.TaskId" class="btn btn-secondary btn-sm" style="display: inline-flex; align-items: center; justify-content: center; height: 32px; box-sizing: border-box; border-color: var(--color-warning); color: var(--color-warning);"><i class="fa-solid fa-pen-to-square"></i> Update Status</a>
                                <form asp-action="Delete" asp-route-id="@item.TaskId" method="post" style="display: contents;" onsubmit="return confirm('Delete this housekeeping task?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-secondary btn-sm" style="display: inline-flex; align-items: center; justify-content: center; height: 32px; box-sizing: border-box; border-color: var(--color-danger); color: var(--color-danger); margin: 0; line-height: normal;"><i class="fa-solid fa-trash"></i> Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
