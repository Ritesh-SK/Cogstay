@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Housekeeping" : roleParam;
    }
    var role = ViewData["Role"]?.ToString() ?? "Housekeeping";
    ViewData["Title"] = "Housekeeping Duties";
}

<div class="table-action-header">
    <div>
        <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Housekeeping & Maintenance Task Board</h1>
        <p style="color: var(--color-text-muted);">Coordinate and monitor room status, cleaning schedules, and service requests.</p>
    </div>
    @if (role == "Admin" || role == "Manager")
    {
        <div>
            <a href="/Housekeeping/Create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Assign New Cleaning Task</a>
        </div>
    }
</div>

<div class="cogstay-card">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-spray-can-sparkles"></i> Room Task Queue</h3>
        <span class="cogstay-badge warning">3 Tasks Active</span>
    </div>
    <div class="cogstay-table-responsive">
        <table class="cogstay-table">
            <thead>
                <tr>
                    <th>Room</th>
                    <th>Task Description</th>
                    <th>Priority</th>
                    <th>Task Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Room 101</strong></td>
                    <td>Standard check-out cleaning: sweep, mop, bed linens change, and toiletries refill.</td>
                    <td><span class="cogstay-badge danger">High</span></td>
                    <td><span class="cogstay-badge danger">Pending</span></td>
                    <td style="text-align: right; display: flex; gap: 8px; justify-content: flex-end;">
                        <a href="/Housekeeping/Details?id=1" class="btn btn-secondary btn-sm">Details</a>
                        <a href="/Housekeeping/Edit?id=1" class="btn btn-secondary btn-sm" style="border-color: var(--color-warning); color: var(--color-warning);">Update Status</a>
                    </td>
                </tr>
                <tr>
                    <td><strong>Room 304</strong></td>
                    <td>Deliver requested extra towels and Aromatherapy spa soap set to John Henderson.</td>
                    <td><span class="cogstay-badge info">Medium</span></td>
                    <td><span class="cogstay-badge warning">In Progress</span></td>
                    <td style="text-align: right; display: flex; gap: 8px; justify-content: flex-end;">
                        <a href="/Housekeeping/Details?id=2" class="btn btn-secondary btn-sm">Details</a>
                        <a href="/Housekeeping/Edit?id=2" class="btn btn-secondary btn-sm" style="border-color: var(--color-warning); color: var(--color-warning);">Update Status</a>
                    </td>
                </tr>
                <tr>
                    <td><strong>Room 205</strong></td>
                    <td>AC thermostat replacement in master bedroom suite.</td>
                    <td><span class="cogstay-badge info">Medium</span></td>
                    <td><span class="cogstay-badge success">Completed</span></td>
                    <td style="text-align: right; display: flex; gap: 8px; justify-content: flex-end;">
                        <a href="/Housekeeping/Details?id=3" class="btn btn-secondary btn-sm">Details</a>
                        <a href="/Housekeeping/Edit?id=3" class="btn btn-secondary btn-sm" style="border-color: var(--color-warning); color: var(--color-warning);">Update Status</a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
