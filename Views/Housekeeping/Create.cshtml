@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Assign Housekeeping Task";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Admin" : roleParam;
    }
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Assign Operational Room Task</h1>
    <p style="color: var(--color-text-muted);">Assign room cleanup, maintenance repairs, or guest amenity requests to housekeeping personnel.</p>
</div>

<div class="cogstay-card" style="max-width: 800px;">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-plus"></i> Task Assignment Form</h3>
    </div>
    <div class="cogstay-card-body">
        <form action="/Housekeeping/Index" method="get">
            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Room Allocation</label>
                    <select class="cogstay-form-control" required>
                        <option value="101">Room 101 (Classic Superior King)</option>
                        <option value="205" selected>Room 205 (Deluxe Executive)</option>
                        <option value="304">Room 304 (Luxury Penthouse Suite)</option>
                    </select>
                </div>
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Priority Urgency</label>
                    <select class="cogstay-form-control" required>
                        <option value="Low">Low</option>
                        <option value="Medium" selected>Medium</option>
                        <option value="High">High (Immediate)</option>
                    </select>
                </div>
            </div>

            <div class="cogstay-form-group">
                <label class="cogstay-form-label">Detailed Task Description</label>
                <textarea class="cogstay-form-control" rows="3" placeholder="Description of cleaning duties, maintenance problems, or guest services..." required></textarea>
            </div>

            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Initial Task Status</label>
                    <select class="cogstay-form-control" required>
                        <option value="Pending" selected>Pending</option>
                        <option value="InProgress">In Progress</option>
                        <option value="Completed">Completed</option>
                    </select>
                </div>
            </div>

            <div style="display: flex; gap: 15px; justify-content: flex-end; margin-top: 20px;">
                <a href="/Housekeeping/Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Assign Task</button>
            </div>
        </form>
    </div>
</div>
