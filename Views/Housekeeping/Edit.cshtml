@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Update Task Status";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Housekeeping" : roleParam;
    }
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Update Room Task Status</h1>
    <p style="color: var(--color-text-muted);">Modify execution status of assigned room cleaning or repair duties.</p>
</div>

<div class="cogstay-card" style="max-width: 800px;">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-spinner"></i> Edit Cleaning/Service Duty Status</h3>
    </div>
    <div class="cogstay-card-body">
        <form action="/Housekeeping/Index" method="get">
            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Allotted Room</label>
                    <input type="text" class="cogstay-form-control" value="Room 101 (Classic Superior King)" readonly />
                </div>
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Urgency Priority</label>
                    <input type="text" class="cogstay-form-control" value="High" readonly />
                </div>
            </div>

            <div class="cogstay-form-group">
                <label class="cogstay-form-label">Task Description Details</label>
                <textarea class="cogstay-form-control" rows="3" readonly>Standard check-out cleaning: sweep, mop, bed linens change, and toiletries refill.</textarea>
            </div>

            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Update Status</label>
                    <select class="cogstay-form-control" required>
                        <option value="Pending">Pending</option>
                        <option value="InProgress" selected>In Progress</option>
                        <option value="Completed">Completed</option>
                    </select>
                </div>
            </div>

            <div style="display: flex; gap: 15px; justify-content: flex-end; margin-top: 20px;">
                <a href="/Housekeeping/Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Update Status</button>
            </div>
        </form>
    </div>
</div>
