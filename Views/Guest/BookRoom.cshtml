@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Book Room";
    ViewData["Role"] = "Guest";
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Reserve Your Stay</h1>
    <p style="color: var(--color-text-muted);">Please fill out the booking configuration details to secure your reservation.</p>
</div>

<div class="booking-checkout-container">
    <!-- Left Column: Booking Form -->
    <div class="cogstay-card">
        <div class="cogstay-card-header">
            <h3 class="cogstay-card-title"><i class="fa-solid fa-calendar-days"></i> Booking Configuration</h3>
        </div>
        <div class="cogstay-card-body">
            <form action="/Guest/MyReservations" method="get">
                <div class="cogstay-form-row">
                    <div class="cogstay-form-group">
                        <label class="cogstay-form-label">Check-In Date</label>
                        <input type="date" class="cogstay-form-control" value="2026-07-22" required />
                    </div>
                    <div class="cogstay-form-group">
                        <label class="cogstay-form-label">Check-Out Date</label>
                        <input type="date" class="cogstay-form-control" value="2026-07-26" required />
                    </div>
                </div>

                <div class="cogstay-form-row">
                    <div class="cogstay-form-group">
                        <label class="cogstay-form-label">Room Type Choice</label>
                        <select class="cogstay-form-control" required>
                            <option value="Deluxe">Deluxe Executive Room (₹14,400 / Night)</option>
                            <option value="Suite" selected>Luxury Penthouse Suite (₹28,000 / Night)</option>
                            <option value="Standard">Classic Superior King (₹11,200 / Night)</option>
                        </select>
                    </div>
                    <div class="cogstay-form-group">
                        <label class="cogstay-form-label">Number of Guests</label>
                        <input type="number" class="cogstay-form-control" min="1" max="4" value="2" required />
                    </div>
                </div>

                <div class="cogstay-form-group" style="margin-top: 10px;">
                    <label class="cogstay-form-label">Special Requests or Comments</label>
                    <textarea class="cogstay-form-control" rows="3" placeholder="Airport pick-up services, extra towels, near-elevator placement..."></textarea>
                </div>

                <div style="margin-top: 20px;">
                    <button type="submit" class="btn btn-primary" style="width: 100%;">Confirm Booking Reservation</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Right Column: Cost Breakdown -->
    <div class="cogstay-card booking-summary-card">
        <div class="cogstay-card-header">
            <h3 class="cogstay-card-title"><i class="fa-solid fa-file-invoice"></i> Stay Cost Summary</h3>
        </div>
        <div class="cogstay-card-body">
            <div class="booking-price-row">
                <span>Penthouse Suite (4 Nights)</span>
                <strong>₹1,12,000.00</strong>
            </div>
            <div class="booking-price-row">
                <span>Stay GST Taxes (18%)</span>
                <strong>₹20,160.00</strong>
            </div>
            <div class="booking-price-row" style="color: var(--color-success);">
                <span>Loyalty discount (Gold Status)</span>
                <strong>-₹11,200.00</strong>
            </div>
            <div class="booking-price-total" style="margin-top: 15px;">
                <span>Total Due</span>
                <strong>₹1,20,960.00</strong>
            </div>
            
            <div style="background-color: var(--color-bg); border-radius: var(--border-radius); padding: 12px; font-size: 12.5px; color: var(--color-text-muted); margin-top: 20px; line-height: 1.4;">
                <i class="fa-solid fa-shield-halved" style="color: var(--color-accent);"></i> Secure stay verification. Payment will be collected in full during guest checkout.
            </div>
        </div>
    </div>
</div>
