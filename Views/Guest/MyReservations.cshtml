@model IEnumerable<CogStayMVC.DTOs.ReservationResponseDTO>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Reservations";
    ViewData["Role"] = "Guest";
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">My Reservations</h1>
    <p style="color: var(--color-text-muted);">Manage and track your active, upcoming, and pending stay reservations.</p>
</div>

<div class="cogstay-card">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-plane-arrival"></i> Active & Upcoming Stays</h3>
        <span class="cogstay-badge info">@Model.Count() Reservations</span>
    </div>
    <div class="cogstay-table-responsive">
        <table class="cogstay-table">
            <thead>
                <tr>
                    <th>Reservation ID</th>
                    <th>Assigned Room</th>
                    <th>Check-In Date</th>
                    <th>Check-Out Date</th>
                    <th>Status</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--color-text-muted);">No reservations found. Book a room to get started.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        string badgeClass = item.ReservationStatus == CogStayMVC.Enums.ReservationStatus.Booked ? "success" : "danger";
                        <tr>
                            <td><strong>#RES-@item.ReservationId</strong></td>
                            <td>Room @item.RoomNumber (@item.RoomType)</td>
                            <td>@item.CheckInDate.ToString("MMM dd, yyyy")</td>
                            <td>@item.CheckOutDate.ToString("MMM dd, yyyy")</td>
                            <td><span class="cogstay-badge @badgeClass">@item.ReservationStatus</span></td>
                            <td style="text-align: right;">
                                <a href="/Guest/CheckInStatus" class="btn btn-secondary btn-sm">Check Status</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
