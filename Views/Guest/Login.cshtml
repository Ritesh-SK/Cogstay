@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Guest Login";
}

<div class="split-login-container">
    <div class="split-login-hero">
        <div class="split-login-hero-overlay"></div>
        <div class="split-login-hero-content">
            <a href="/Home/Index" class="split-login-brand">
                <i class="fa-solid fa-hotel"></i> CogStay
            </a>
            <h1>Experience Exclusive Hospitality</h1>
            <p>Welcome back to the CogStay Guest Portal. Access your reservations, book services, view billing, and manage your luxury stay profile.</p>
        </div>
    </div>
    
    <div class="split-login-panel">
        <div class="split-login-panel-content">
            <div class="cogstay-login-card">
                <div class="cogstay-login-header">
                    <h2 class="cogstay-login-title">Guest Login</h2>
                    <p class="cogstay-login-desc">Sign in to manage your luxury stay</p>
                </div>
                
                <form action="/Guest/Dashboard" method="get">
                    <div class="cogstay-form-group">
                        <label class="cogstay-form-label">Email Address</label>
                        <input type="email" class="cogstay-form-control" placeholder="guest@example.com" required />
                    </div>
                    
                    <div class="cogstay-form-group">
                        <label class="cogstay-form-label">Password</label>
                        <input type="password" class="cogstay-form-control" placeholder="••••••••" required />
                    </div>
                    
                    <button type="submit" class="btn btn-accent" style="width: 100%; color: var(--color-primary-dark); font-weight: 700; margin-top: 10px;">Sign In</button>
                </form>
                
                <div style="text-align: center; margin-top: 20px; font-size: 14px;">
                    <span style="color: var(--color-text-muted);">Don't have an account? </span>
                    <a href="/Guest/Register" style="color: var(--color-primary); font-weight: 600; text-decoration: underline;">Register here</a>
                </div>
            </div>
            
            <a href="/Home/Index" style="text-align: center; color: var(--color-text-muted); font-size: 14px; font-weight: 500;">
                <i class="fa-solid fa-arrow-left-long"></i> Back to Homepage
            </a>
        </div>
    </div>
</div>
