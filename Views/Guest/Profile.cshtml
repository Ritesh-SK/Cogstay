@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Guest Profile";
    ViewData["Role"] = "Guest";
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Personal Profile Settings</h1>
    <p style="color: var(--color-text-muted);">View or update your hospitality profile information and address details.</p>
</div>

<div class="booking-checkout-container">
    <div class="cogstay-card">
        <div class="cogstay-card-header">
            <h3 class="cogstay-card-title"><i class="fa-solid fa-user-gear"></i> Update Profile Details</h3>
        </div>
        <div class="cogstay-card-body">
            <form action="/Guest/Profile" method="get">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Full Name</label>
                    <input type="text" class="cogstay-form-control" value="John Henderson" required />
                </div>
                
                <div class="cogstay-form-row">
                    <div class="cogstay-form-group">
                        <label class="cogstay-form-label">Email Address</label>
                        <input type="email" class="cogstay-form-control" value="guest@example.com" required readonly />
                    </div>
                    <div class="cogstay-form-group">
                        <label class="cogstay-form-label">Phone Number</label>
                        <input type="tel" class="cogstay-form-control" value="+91 98765-43210" required />
                    </div>
                </div>

                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Address</label>
                    <input type="text" class="cogstay-form-control" value="Flat 3B, luxury Apartment Tower C, Mumbai, Maharashtra" required />
                </div>

                <button type="submit" class="btn btn-primary" style="margin-top: 10px;">Save Profile Changes</button>
            </form>
        </div>
    </div>

    <div>
        <div class="profile-header-card">
            <div style="display: flex; flex-direction: column; align-items: center; text-align: center; width: 100%; gap: 15px;">
                <div class="profile-avatar-large">JH</div>
                <div>
                    <h3 style="font-family: var(--font-serif); font-size: 20px; color: var(--color-accent-light);">John Henderson</h3>
                    <span style="font-size: 12px; color: rgba(255,255,255,0.75); text-transform: uppercase; letter-spacing: 0.5px;">Gold Class Guest</span>
                </div>
            </div>
        </div>

        <div class="cogstay-card">
            <div class="cogstay-card-header">
                <h3 class="cogstay-card-title"><i class="fa-solid fa-crown"></i> Membership Benefits</h3>
            </div>
            <div class="cogstay-card-body" style="font-size: 13.5px; line-height: 1.5; color: var(--color-text-muted);">
                As a premium <strong>Gold Class Member</strong>, you receive:
                <ul style="margin-top: 10px; margin-left: 20px; display: flex; flex-direction: column; gap: 8px;">
                    <li>15% discount on in-room dining services</li>
                    <li>Priority early check-in privileges</li>
                    <li>Complimentary high-speed premium Wi-Fi</li>
                </ul>
            </div>
        </div>
    </div>
</div>
