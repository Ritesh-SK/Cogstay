@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Check-In Status";
    ViewData["Role"] = "Guest";
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Check-In Operations Status</h1>
    <p style="color: var(--color-text-muted);">Real-time tracking of your room allotment and arrival clearance status.</p>
</div>

<div class="booking-checkout-container">
    <div class="cogstay-card">
        <div class="cogstay-card-header">
            <h3 class="cogstay-card-title"><i class="fa-solid fa-hotel"></i> Arrival Status & Room Allotment</h3>
        </div>
        <div class="cogstay-card-body">
            <div class="grid-container grid-cols-2" style="gap: 20px; margin-bottom: 25px;">
                <div style="border-bottom: 1px solid var(--color-border); padding-bottom: 10px;">
                    <span style="font-size: 13px; color: var(--color-text-muted); font-weight: 600; text-transform: uppercase;">Allotment Status</span>
                    <h4 style="margin-top: 5px; color: var(--color-success); font-family: var(--font-serif);"><i class="fa-solid fa-circle-check"></i> Checked-In / Allotted</h4>
                </div>
                <div style="border-bottom: 1px solid var(--color-border); padding-bottom: 10px;">
                    <span style="font-size: 13px; color: var(--color-text-muted); font-weight: 600; text-transform: uppercase;">Assigned Key Room</span>
                    <h4 style="margin-top: 5px; color: var(--color-primary-dark); font-family: var(--font-serif);">Room 304 (Penthouse Suite)</h4>
                </div>
                <div>
                    <span style="font-size: 13px; color: var(--color-text-muted); font-weight: 600; text-transform: uppercase;">Expected Check-In Time</span>
                    <p style="font-size: 15px; font-weight: 600; margin-top: 5px;">June 24, 2026 at 2:00 PM</p>
                </div>
                <div>
                    <span style="font-size: 13px; color: var(--color-text-muted); font-weight: 600; text-transform: uppercase;">Expected Check-Out Time</span>
                    <p style="font-size: 15px; font-weight: 600; margin-top: 5px;">June 28, 2026 at 11:00 AM</p>
                </div>
            </div>

            <div style="background-color: var(--color-info-light); color: var(--color-info); border-radius: var(--border-radius); padding: 15px; font-size: 14px; line-height: 1.5;">
                <strong style="display: block; margin-bottom: 5px;"><i class="fa-solid fa-concierge-bell"></i> Need to extend your stay?</strong>
                If you require a late check-out or want to extend your stay in Room 304, please contact the front desk operations team directly. Extra charges may apply based on room occupancy.
            </div>
        </div>
    </div>

    <div>
        <div class="cogstay-card">
            <div class="cogstay-card-header">
                <h3 class="cogstay-card-title"><i class="fa-solid fa-key"></i> Key Allotment</h3>
            </div>
            <div class="cogstay-card-body" style="text-align: center;">
                <div class="cogstay-stat-icon" style="background-color: var(--color-success-light); color: var(--color-success); width: 64px; height: 64px; font-size: 26px; margin: 0 auto 15px;">
                    <i class="fa-solid fa-mobile-screen-button"></i>
                </div>
                <h4 style="font-family: var(--font-serif); font-size: 18px; margin-bottom: 10px;">Digital RFID Active</h4>
                <p style="font-size: 13px; color: var(--color-text-muted); line-height: 1.4; margin-bottom: 15px;">Your mobile key card has been activated by the front desk operations team for Room 304.</p>
                <a href="/Guest/Dashboard" class="btn btn-secondary btn-sm" style="width: 100%;">Return to Dashboard</a>
            </div>
        </div>
    </div>
</div>
