@model IEnumerable<CogStayMVC.DTOs.BillingResponseDTO>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Billing History Archive";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Admin" : roleParam;
    }
}

<div class="table-action-header">
    <div>
        <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Billing History Archive</h1>
        <p style="color: var(--color-text-muted);">View all processed payments and completed invoice records.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back to Active Billing</a>
    </div>
</div>

<div class="cogstay-card">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-clock-rotate-left"></i> Invoices Log</h3>
        <span class="cogstay-badge success">@Model.Count() Total Invoices</span>
    </div>
    <div class="cogstay-table-responsive">
        <table class="cogstay-table">
            <thead>
                <tr>
                    <th>Bill ID</th>
                    <th>Guest Name</th>
                    <th>Room Number</th>
                    <th>Total Amount</th>
                    <th>Payment Status</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--color-text-muted);">No invoice history records found.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        string badgeClass = item.PaymentStatus == CogStayMVC.Enums.PaymentStatus.Paid ? "success" : "danger";
                        <tr>
                            <td><strong>#BILL-@item.BillId</strong></td>
                            <td>@item.GuestName</td>
                            <td>Room @item.RoomNumber</td>
                            <td>@item.TotalAmount.ToString("C")</td>
                            <td><span class="cogstay-badge @badgeClass">@item.PaymentStatus</span></td>
                            <td>@item.Remarks</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
