@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Generate Invoice";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Admin" : roleParam;
    }
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Generate Guest Invoice</h1>
    <p style="color: var(--color-text-muted);">Consolidate stay room charges, dining invoices, and service fees into a final statement.</p>
</div>

<div class="cogstay-card" style="max-width: 800px;">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-file-invoice"></i> Compile Statement Details</h3>
    </div>
    <div class="cogstay-card-body">
        <form action="/Billing/Index" method="get">
            <div class="cogstay-form-group">
                <label class="cogstay-form-label">Select Active Guest Stay Account</label>
                <select class="cogstay-form-control" required>
                    <option value="1">John Henderson (Room 304 - Penthouse Suite)</option>
                </select>
            </div>

            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Total Room Stay Charge (₹)</label>
                    <input type="number" class="cogstay-form-control" value="112000.00" required />
                </div>
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Minibar & Room Service Dining (₹)</label>
                    <input type="number" class="cogstay-form-control" value="12000.00" required />
                </div>
            </div>

            <div class="cogstay-form-group">
                <label class="cogstay-form-label">Remarks / Special Adjustments</label>
                <input type="text" class="cogstay-form-control" placeholder="E.g., Added extra dry cleaning service fees." value="Minibar snack selections, extra laundry dry-cleaning services." />
            </div>

            <div style="display: flex; gap: 15px; justify-content: flex-end; margin-top: 20px;">
                <a href="/Billing/Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Generate & Print Invoice</button>
            </div>
        </form>
    </div>
</div>
