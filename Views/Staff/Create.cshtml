@model CogStayMVC.DTOs.CreateStaffDTO
@using CogStayMVC.Enums
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Add Staff Member";
    ViewData["Role"] = "Admin";
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Add Corporate Staff Profile</h1>
    <p style="color: var(--color-text-muted);">Enroll a new staff member and assign their operational security role.</p>
</div>

<div class="cogstay-card" style="max-width: 800px;">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-user-plus"></i> Staff Enrollment Form</h3>
    </div>
    <div class="cogstay-card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="cogstay-form-group">
                <label class="cogstay-form-label" asp-for="FullName">Full Name</label>
                <input asp-for="FullName" class="cogstay-form-control" placeholder="Jane Doe" required />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="Email">Corporate Email Address</label>
                    <input asp-for="Email" type="email" class="cogstay-form-control" placeholder="j.doe@cogstay.com" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="PhoneNumber">Contact Phone Number</label>
                    <input asp-for="PhoneNumber" type="tel" class="cogstay-form-control" placeholder="+91 99999-77777" required />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="Password">Initial Access Password</label>
                    <input asp-for="Password" type="password" class="cogstay-form-control" placeholder="••••••••" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="Role">Assigned Role</label>
                    <select asp-for="Role" asp-items="Html.GetEnumSelectList<StaffRole>()" class="cogstay-form-control" required></select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
            </div>

            <div style="display: flex; gap: 15px; justify-content: flex-end; margin-top: 20px;">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Enroll Staff Member</button>
            </div>
        </form>
    </div>
</div>
