@model IEnumerable<CogStayMVC.DTOs.StayRecordResponseDTO>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Check-In Status";
    ViewData["Role"] = "Admin";
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Check-In Operations Status</h1>
    <p style="color: var(--color-text-muted);">Real-time tracking of room allotment and arrival clearance status.</p>
</div>

<div class="cogstay-card">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-hotel"></i> Active Stay Records</h3>
        <span class="cogstay-badge info">@Model.Count() Records</span>
    </div>
    <div class="cogstay-table-responsive">
        <table class="cogstay-table">
            <thead>
                <tr>
                    <th>Stay ID</th>
                    <th>Guest Name</th>
                    <th>Room Number</th>
                    <th>Actual Check-In</th>
                    <th>Actual Check-Out</th>
                    <th>Status</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align: center; color: var(--color-text-muted);">No stay records found.</td>
                    </tr>
                }
                else
                {
                    foreach (var stay in Model)
                    {
                        bool isCheckedOut = stay.ActualCheckOut.HasValue;
                        string status = isCheckedOut ? "Checked-Out" : "Checked-In";
                        string badgeClass = isCheckedOut ? "secondary" : "success";

                        <tr>
                            <td><strong>#STAY-@stay.StayId</strong></td>
                            <td>@stay.GuestName</td>
                            <td>Room @stay.RoomNumber</td>
                            <td>@(stay.ActualCheckIn.HasValue ? stay.ActualCheckIn.Value.ToString("MMM dd, yyyy HH:mm") : "N/A")</td>
                            <td>@(isCheckedOut ? stay.ActualCheckOut!.Value.ToString("MMM dd, yyyy HH:mm") : "Active")</td>
                            <td><span class="cogstay-badge @badgeClass">@status</span></td>
                            <td style="text-align: right;">
                                @if (!isCheckedOut)
                                {
                                    <form asp-controller="Staff" asp-action="RequestCheckOut" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="stayId" value="@stay.StayId" />
                                        <button type="submit" class="btn btn-warning btn-sm">Request Checkout</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
