@model CogStayMVC.DTOs.StaffLoginDTO
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Staff Login";
}

<div class="split-login-container">
    <div class="split-login-hero">
        <div class="split-login-hero-overlay"></div>
        <div class="split-login-hero-content">
            <a asp-controller="Home" asp-action="Index" class="split-login-brand">
                <i class="fa-solid fa-hotel"></i> CogStay
            </a>
            <h1>Operations Console</h1>
            <p>Welcome to the CogStay Operations Portal. Access specialized workflows for guest reservation tracking, check-ins, cleaning duties, and management oversight.</p>
        </div>
    </div>
    
    <div class="split-login-panel">
        <div class="split-login-panel-content">
            <div class="cogstay-login-card">
                <div class="cogstay-login-header">
                    <h2 class="cogstay-login-title">Staff Login</h2>
                    <p class="cogstay-login-desc">Sign in with your corporate credentials</p>
                </div>
                
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="cogstay-form-group">
                        <label class="cogstay-form-label" asp-for="Email">Corporate Email Address</label>
                        <input asp-for="Email" type="email" class="cogstay-form-control" placeholder="staff@cogstay.com" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="cogstay-form-group">
                        <label class="cogstay-form-label" asp-for="Role">Department Role</label>
                        <select asp-for="Role" asp-items="Html.GetEnumSelectList<StaffRole>()" class="cogstay-form-control" required></select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>
                    
                    <div class="cogstay-form-group">
                        <label class="cogstay-form-label" asp-for="Password">Security Password</label>
                        <input asp-for="Password" type="password" class="cogstay-form-control" placeholder="••••••••" required />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    
                    <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px;">Access Panel</button>
                </form>
                

            </div>
            
            <a asp-controller="Home" asp-action="Index" style="text-align: center; color: var(--color-text-muted); font-size: 14px; font-weight: 500;">
                <i class="fa-solid fa-arrow-left-long"></i> Back to Homepage
            </a>
        </div>
    </div>
</div>
