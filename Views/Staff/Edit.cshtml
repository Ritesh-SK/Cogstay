@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Update Staff Member";
    ViewData["Role"] = "Admin";
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Update Staff Profile</h1>
    <p style="color: var(--color-text-muted);">Modify contact details or adjust operational roles for staff profiles.</p>
</div>

<div class="cogstay-card" style="max-width: 800px;">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-user-pen"></i> Edit Staff Member Profile</h3>
    </div>
    <div class="cogstay-card-body">
        <form action="/Staff/Index" method="get">
            <div class="cogstay-form-group">
                <label class="cogstay-form-label">Full Name</label>
                <input type="text" class="cogstay-form-control" value="Alexander Pierce" required />
            </div>

            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Corporate Email Address</label>
                    <input type="email" class="cogstay-form-control" value="a.pierce@cogstay.com" required readonly />
                </div>
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Contact Phone Number</label>
                    <input type="tel" class="cogstay-form-control" value="+91 98888-77777" required />
                </div>
            </div>

            <div class="cogstay-form-group">
                <label class="cogstay-form-label">Assigned Role</label>
                <select class="cogstay-form-control" required>
                    <option value="FrontDesk" selected>Front Desk Staff</option>
                    <option value="Housekeeping">Housekeeping Staff</option>
                    <option value="Manager">Manager</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>

            <div style="display: flex; gap: 15px; justify-content: flex-end; margin-top: 20px;">
                <a href="/Staff/Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Profile Changes</button>
            </div>
        </form>
    </div>
</div>
