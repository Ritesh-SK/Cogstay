@model CogStayMVC.DTOs.UpdateStaffDTO
@using CogStayMVC.Enums
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Update Staff Member";
    ViewData["Role"] = "Admin";
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Update Staff Profile</h1>
    <p style="color: var(--color-text-muted);">Modify contact details or adjust operational roles for staff profiles.</p>
</div>

<div class="cogstay-card" style="max-width: 800px;">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-user-pen"></i> Edit Staff Member Profile</h3>
    </div>
    <div class="cogstay-card-body">
        <form asp-action="Edit" asp-route-id="@Model.StaffId" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="StaffId" />

            <div class="cogstay-form-group">
                <label class="cogstay-form-label" asp-for="FullName">Full Name</label>
                <input asp-for="FullName" class="cogstay-form-control" required />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="Email">Corporate Email Address</label>
                    <input asp-for="Email" type="email" class="cogstay-form-control" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="PhoneNumber">Contact Phone Number</label>
                    <input asp-for="PhoneNumber" type="tel" class="cogstay-form-control" required />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="Role">Assigned Role</label>
                    <select asp-for="Role" asp-items="Html.GetEnumSelectList<StaffRole>()" class="cogstay-form-control" required></select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
                <div class="cogstay-form-group" style="display: flex; align-items: center; gap: 10px; margin-top: 25px;">
                    <input type="checkbox" asp-for="IsActive" style="width: 18px; height: 18px;" />
                    <label class="cogstay-form-label" asp-for="IsActive" style="margin-bottom: 0;">Account Active</label>
                </div>
            </div>

            <div style="display: flex; gap: 15px; justify-content: flex-end; margin-top: 20px;">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Profile Changes</button>
            </div>
        </form>
    </div>
</div>
