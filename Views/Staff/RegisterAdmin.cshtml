@model CogStayMVC.DTOs.CreateStaffDTO
@using CogStayMVC.Enums
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin Registration";
}

<div class="split-login-container">
    <div class="split-login-hero">
        <div class="split-login-hero-overlay"></div>
        <div class="split-login-hero-content">
            <a asp-controller="Home" asp-action="Index" class="split-login-brand">
                <i class="fa-solid fa-hotel"></i> CogStay
            </a>
            <h1>Operations Console</h1>
            <p>Register as an Administrator to manage staff accounts, monitor occupancy and bookings, configure settings, and oversee complete hotel operations.</p>
        </div>
    </div>
    
    <div class="split-login-panel">
        <div class="split-login-panel-content">
            <div class="cogstay-login-card">
                <div class="cogstay-login-header">
                    <h2 class="cogstay-login-title">Admin Registration</h2>
                    <p class="cogstay-login-desc">Register a new administrator account</p>
                </div>
                
                <form asp-action="RegisterAdmin" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <input type="hidden" asp-for="Role" value="@StaffRole.Admin" />

                    <div class="cogstay-form-group">
                        <label class="cogstay-form-label" asp-for="FullName">Full Name</label>
                        <input asp-for="FullName" class="cogstay-form-control" placeholder="Admin Name" required />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    
                    <div class="cogstay-form-row">
                        <div class="cogstay-form-group">
                            <label class="cogstay-form-label" asp-for="Email">Corporate Email Address</label>
                            <input asp-for="Email" type="email" class="cogstay-form-control" placeholder="admin@cogstay.com" required />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="cogstay-form-group">
                            <label class="cogstay-form-label" asp-for="PhoneNumber">Phone Number</label>
                            <input asp-for="PhoneNumber" type="tel" class="cogstay-form-control" placeholder="+91 99999-88888" required />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="cogstay-form-group">
                        <label class="cogstay-form-label">System Role</label>
                        <input type="text" class="cogstay-form-control" value="Administrator" readonly disabled />
                    </div>
                    
                    <div class="cogstay-form-group">
                        <label class="cogstay-form-label" asp-for="Password">Security Password</label>
                        <input asp-for="Password" type="password" class="cogstay-form-control" placeholder="••••••••" required />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    
                    <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px;">Register Admin</button>
                </form>
                
                <div style="text-align: center; margin-top: 20px; font-size: 14px;">
                    <span style="color: var(--color-text-muted);">Already registered? </span>
                    <a asp-action="Login" style="color: var(--color-primary); font-weight: 600; text-decoration: underline;">Login here</a>
                </div>
            </div>
            
            <a asp-controller="Home" asp-action="Index" style="text-align: center; color: var(--color-text-muted); font-size: 14px; font-weight: 500;">
                <i class="fa-solid fa-arrow-left-long"></i> Back to Homepage
            </a>
        </div>
    </div>
</div>
