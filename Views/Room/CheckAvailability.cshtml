@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Check Room Availability";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Admin" : roleParam;
    }
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Check Room Availability</h1>
    <p style="color: var(--color-text-muted);">Inquire about available room stock and pricing allocations for specific date ranges.</p>
</div>

<div class="cogstay-card" style="max-width: 800px;">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-magnifying-glass"></i> Availability Search Inquiry</h3>
    </div>
    <div class="cogstay-card-body">
        <form action="/Room/Index" method="get">
            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Check-In Arrival Date</label>
                    <input type="date" class="cogstay-form-control" required />
                </div>
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Check-Out Departure Date</label>
                    <input type="date" class="cogstay-form-control" required />
                </div>
            </div>

            <div class="cogstay-form-group">
                <label class="cogstay-form-label">Room Type Tier</label>
                <select class="cogstay-form-control" required>
                    <option value="All">All Room Classifications</option>
                    <option value="Classic">Classic Superior King</option>
                    <option value="Deluxe">Deluxe Executive Room</option>
                    <option value="Penthouse">Luxury Penthouse Suite</option>
                </select>
            </div>

            <div style="display: flex; gap: 15px; justify-content: flex-end; margin-top: 20px;">
                <a href="/Room/Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-circle-question"></i> Check Available Inventory</button>
            </div>
        </form>
    </div>
</div>
