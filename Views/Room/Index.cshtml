@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Room Catalog";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Admin" : roleParam;
    }
}

<div class="table-action-header">
    <div>
        <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Room Inventory Catalog</h1>
        <p style="color: var(--color-text-muted);">Manage room allocations, pricing per night, and maintenance statuses.</p>
    </div>
    <div style="display: flex; gap: 10px;">
        <a href="/Room/CheckAvailability" class="btn btn-secondary"><i class="fa-solid fa-magnifying-glass"></i> Check Availability</a>
        <a href="/Room/Create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Add New Room</a>
    </div>
</div>

<div class="cogstay-card">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-door-open"></i> All Guest Rooms</h3>
        <span class="cogstay-badge info">3 Rooms Configured</span>
    </div>
    <div class="cogstay-table-responsive">
        <table class="cogstay-table">
            <thead>
                <tr>
                    <th>Room Number</th>
                    <th>Room Type</th>
                    <th>Price Per Night</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>101</strong></td>
                    <td>Classic Superior King</td>
                    <td>₹11,200.00</td>
                    <td><span class="cogstay-badge success">Available</span></td>
                    <td style="text-align: right; display: flex; gap: 8px; justify-content: flex-end;">
                        <a href="/Room/Details?id=101" class="btn btn-secondary btn-sm">View</a>
                        <a href="/Room/Edit?id=101" class="btn btn-secondary btn-sm" style="border-color: var(--color-warning); color: var(--color-warning);"><i class="fa-solid fa-pen-to-square"></i> Edit</a>
                    </td>
                </tr>
                <tr>
                    <td><strong>205</strong></td>
                    <td>Deluxe Executive Room</td>
                    <td>₹14,400.00</td>
                    <td><span class="cogstay-badge danger">Occupied</span></td>
                    <td style="text-align: right; display: flex; gap: 8px; justify-content: flex-end;">
                        <a href="/Room/Details?id=205" class="btn btn-secondary btn-sm">View</a>
                        <a href="/Room/Edit?id=205" class="btn btn-secondary btn-sm" style="border-color: var(--color-warning); color: var(--color-warning);"><i class="fa-solid fa-pen-to-square"></i> Edit</a>
                    </td>
                </tr>
                <tr>
                    <td><strong>304</strong></td>
                    <td>Luxury Penthouse Suite</td>
                    <td>₹28,000.00</td>
                    <td><span class="cogstay-badge warning">Under Maintenance</span></td>
                    <td style="text-align: right; display: flex; gap: 8px; justify-content: flex-end;">
                        <a href="/Room/Details?id=304" class="btn btn-secondary btn-sm">View</a>
                        <a href="/Room/Edit?id=304" class="btn btn-secondary btn-sm" style="border-color: var(--color-warning); color: var(--color-warning);"><i class="fa-solid fa-pen-to-square"></i> Edit</a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
