@model CogStayMVC.DTOs.CreateRoomDTO
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Add Room";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Admin" : roleParam;
    }
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Add Room Record</h1>
    <p style="color: var(--color-text-muted);">Define a new physical guest room inside the hotel catalog system.</p>
</div>

<div class="cogstay-card" style="max-width: 800px;">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-plus"></i> Configure New Room</h3>
    </div>
    <div class="cogstay-card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="RoomNumber">Room Number</label>
                    <input asp-for="RoomNumber" class="cogstay-form-control" placeholder="E.g., 302" required />
                    <span asp-validation-for="RoomNumber" class="text-danger"></span>
                </div>
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="RoomType">Room Type</label>
                    <input asp-for="RoomType" class="cogstay-form-control" placeholder="E.g., Deluxe Executive Suite" required />
                    <span asp-validation-for="RoomType" class="text-danger"></span>
                </div>
            </div>

            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="PricePerNight">Price Per Night (₹)</label>
                    <input asp-for="PricePerNight" type="number" step="0.01" class="cogstay-form-control" placeholder="14400.00" required />
                    <span asp-validation-for="PricePerNight" class="text-danger"></span>
                </div>
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="Status">Initial Status</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<RoomStatus>()" class="cogstay-form-control" required></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>

            <div style="display: flex; gap: 15px; justify-content: flex-end; margin-top: 20px;">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Add Room</button>
            </div>
        </form>
    </div>
</div>
