@model CogStayMVC.DTOs.UpdateRoomDTO
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Update Room";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Admin" : roleParam;
    }
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Update Room Details</h1>
    <p style="color: var(--color-text-muted);">Adjust pricing and status controls for guest rooms.</p>
</div>

<div class="cogstay-card" style="max-width: 800px;">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-pen-to-square"></i> Edit Room Allotments</h3>
    </div>
    <div class="cogstay-card-body">
        <form asp-action="Edit" asp-route-id="@Model.RoomId" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="RoomId" />

            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="RoomNumber">Room Number</label>
                    <input asp-for="RoomNumber" class="cogstay-form-control" required />
                    <span asp-validation-for="RoomNumber" class="text-danger"></span>
                </div>
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="RoomType">Room Type</label>
                    <input asp-for="RoomType" class="cogstay-form-control" required />
                    <span asp-validation-for="RoomType" class="text-danger"></span>
                </div>
            </div>

            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="PricePerNight">Price Per Night (₹)</label>
                    <input asp-for="PricePerNight" type="number" step="0.01" class="cogstay-form-control" required />
                    <span asp-validation-for="PricePerNight" class="text-danger"></span>
                </div>
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label" asp-for="Status">Allotment Status</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<RoomStatus>()" class="cogstay-form-control" required></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>

            <div style="display: flex; gap: 15px; justify-content: flex-end; margin-top: 20px;">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>
