@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Update Room";
    if (ViewData["Role"] == null)
    {
        var roleParam = Context.Request.Query["role"].ToString();
        ViewData["Role"] = string.IsNullOrEmpty(roleParam) ? "Admin" : roleParam;
    }
}

<div style="margin-bottom: 30px;">
    <h1 style="font-family: var(--font-serif); font-size: 32px; color: var(--color-primary-dark);">Update Room Details</h1>
    <p style="color: var(--color-text-muted);">Adjust pricing and status controls for guest rooms.</p>
</div>

<div class="cogstay-card" style="max-width: 800px;">
    <div class="cogstay-card-header">
        <h3 class="cogstay-card-title"><i class="fa-solid fa-pen-to-square"></i> Edit Room Allotments</h3>
    </div>
    <div class="cogstay-card-body">
        <form action="/Room/Index" method="get">
            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Room Number</label>
                    <input type="text" class="cogstay-form-control" value="205" readonly required />
                </div>
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Room Type</label>
                    <select class="cogstay-form-control" required>
                        <option value="Classic">Classic Superior King</option>
                        <option value="Deluxe" selected>Deluxe Executive Room</option>
                        <option value="Penthouse">Luxury Penthouse Suite</option>
                    </select>
                </div>
            </div>

            <div class="cogstay-form-row">
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Price Per Night (₹)</label>
                    <input type="number" class="cogstay-form-control" value="14400.00" step="0.01" required />
                </div>
                <div class="cogstay-form-group">
                    <label class="cogstay-form-label">Allotment Status</label>
                    <select class="cogstay-form-control" required>
                        <option value="Available">Available</option>
                        <option value="Occupied" selected>Occupied</option>
                        <option value="UnderMaintenance">Under Maintenance</option>
                    </select>
                </div>
            </div>

            <div style="display: flex; gap: 15px; justify-content: flex-end; margin-top: 20px;">
                <a href="/Room/Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>
